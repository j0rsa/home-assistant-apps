#!/bin/bash
set -euo pipefail

# Run a Wolfi-linked ELF (CPython, Prisma engines) against the glibc copied
# from the same upstream image. Ubuntu 26.04 only ships glibc 2.43; Wolfi
# CPython 3.13 needs GLIBC_2.44. Do not export LD_LIBRARY_PATH — that would
# leak Wolfi libs into Ubuntu subprocesses (openssl/s6/bashio).
loader=""
for candidate in /opt/litellm/lib/ld-linux*.so*; do
    if [ -e "${candidate}" ]; then
        loader="${candidate}"
        break
    fi
done

if [ -z "${loader}" ]; then
    echo "with-wolfi-ld: missing /opt/litellm/lib/ld-linux*.so*" >&2
    exit 1
fi

multiarch="$(uname -m)-linux-gnu"
libpath="/opt/litellm/lib:/usr/lib/${multiarch}:/lib/${multiarch}:/usr/lib:/lib"

exec "${loader}" --library-path "${libpath}" "$@"
