#!/bin/bash
set -euo pipefail

# Point Wolfi CPython, its extensions, and Prisma engines at the glibc loader
# copied into /opt/litellm/lib. Ubuntu 26.04 only ships glibc 2.43; Wolfi
# CPython 3.13 needs GLIBC_2.44. Binaries stay in place (no bash wrappers) so
# venv detection via argv[0] / pyvenv.cfg still works.
#
# DT_RPATH (--force-rpath) is required so dlopened modules such as
# math.cpython-*.so also search /opt/litellm/lib for libm. DT_RUNPATH is not
# inherited by dlopen dependents.

LOADER=""
for candidate in /opt/litellm/lib/ld-linux*.so*; do
    if [ -e "${candidate}" ]; then
        LOADER="${candidate}"
        break
    fi
done

if [ -z "${LOADER}" ]; then
    echo "wrap-wolfi-python: missing /opt/litellm/lib/ld-linux*.so*" >&2
    exit 1
fi

is_elf() {
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(head -c 4 "$1")" = $'\x7fELF' ]
}

multiarch="$(uname -m)-linux-gnu"
rpath="/opt/litellm/lib:/usr/lib/${multiarch}:/lib/${multiarch}:/usr/lib:/lib"

relocate_elf() {
    local f="$1"
    if ! is_elf "${f}"; then
        return 0
    fi
    case "${f}" in
        /opt/litellm/lib/*)
            return 0
            ;;
    esac
    if patchelf --print-interpreter "${f}" >/dev/null 2>&1; then
        patchelf --set-interpreter "${LOADER}" --force-rpath --set-rpath "${rpath}" "${f}"
    elif patchelf --print-needed "${f}" >/dev/null 2>&1; then
        patchelf --force-rpath --set-rpath "${rpath}" "${f}"
    fi
}

while IFS= read -r -d '' f; do
    relocate_elf "${f}"
done < <(find \
    /usr/bin \
    /usr/lib/python3.* \
    /usr/lib/libpython*.so* \
    /app/.venv \
    /opt/prisma \
    -type f \( -name 'python' -o -name 'python3' -o -name 'python3.*' -o -name '*.so' -o -name '*.so.*' -o -name 'query-engine*' -o -name 'schema-engine*' -o -name 'prisma*' \) \
    -print0 2>/dev/null)

# Catch Prisma binaries that do not match the name globs above.
if [ -d /opt/prisma ]; then
    while IFS= read -r -d '' f; do
        if is_elf "${f}" && patchelf --print-interpreter "${f}" >/dev/null 2>&1; then
            relocate_elf "${f}"
        fi
    done < <(find /opt/prisma -type f -print0)
fi
